#!/usr/bin/env bash
# Bring an application to the front (launching it if needed).
#   mac-app Safari
#   mac-app "Visual Studio Code"
set -uo pipefail
. "$(dirname "$0")/mac-lib.sh"

mac_need_arg "${1:-}" '<AppName>'
app="$*"
if ! mac_osa "tell application \"$app\" to activate"; then
  mac_gui_hint
  exit 1
fi
printf '%s is now frontmost.\n' "$app"
