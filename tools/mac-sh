#!/usr/bin/env bash
# Run a shell command on the Mac.
#   mac-sh "ls ~/Downloads | head"
#   mac-sh sw_vers
#
# Anything classified risky (rm, sudo, mv, killall, chmod -R…) files an
# approval request and blocks until it's approved or denied in the dashboard.
# Anything classified as data-loss-on-disk (rm -rf /, diskutil erase, dd…) is
# refused outright — see tools/mac-guard.sh.
set -uo pipefail
. "$(dirname "$0")/mac-lib.sh"
. "$(dirname "$0")/mac-guard.sh"

mac_need_arg "${1:-}" '<command…>'
cmd="$*"
mac_guard "mac-sh" "run a shell command on the Mac" "$cmd" || exit 1
mac_run "$cmd"
