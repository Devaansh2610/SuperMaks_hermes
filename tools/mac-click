#!/usr/bin/env bash
# Click at screen coordinates on the Mac. Needs cliclick there:
#   brew install cliclick
#
#   mac-click 640 400          left click
#   mac-click 640 400 double
#   mac-click 640 400 right
#
# Coordinates are in points from the top-left of the main display. Take a
# mac-shot first if you need to know where something is.
set -uo pipefail
. "$(dirname "$0")/mac-lib.sh"

x="${1:-}"; y="${2:-}"; kind="${3:-left}"
{ [ -n "$x" ] && [ -n "$y" ]; } || mac_die "usage: $(basename "$0") <x> <y> [left|right|double]"
case "$x$y" in *[!0-9]*) mac_die "coordinates must be integers" ;; esac

case "$kind" in
  left)   verb="c:$x,$y" ;;
  right)  verb="rc:$x,$y" ;;
  double) verb="dc:$x,$y" ;;
  *)      mac_die "unknown click type: $kind" ;;
esac

if ! mac_run "command -v cliclick >/dev/null 2>&1"; then
  mac_die "cliclick is not installed on the Mac. Run: brew install cliclick"
fi
if ! mac_run "cliclick $verb"; then
  mac_gui_hint
  exit 1
fi
printf 'clicked %s at %s,%s\n' "$kind" "$x" "$y"
