#!/usr/bin/env bash
# Open a URL, file, or application on the Mac.
#   mac-open https://news.ycombinator.com
#   mac-open ~/Desktop/report.pdf
#   mac-open -a Xcode
set -uo pipefail
. "$(dirname "$0")/mac-lib.sh"

mac_need_arg "${1:-}" '<url|path|-a AppName>'

quoted=""
for arg in "$@"; do quoted="$quoted $(mac_q "$arg")"; done
mac_run "open$quoted"
