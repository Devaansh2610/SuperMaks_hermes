#!/usr/bin/env bash
# Type text into whatever is focused on the Mac.
#   mac-app Notes && mac-type "meeting notes"
set -uo pipefail
. "$(dirname "$0")/mac-lib.sh"

mac_need_arg "${1:-}" '<text>'
text="$*"
# Escape for an AppleScript string literal: backslash first, then quote.
esc=${text//\\/\\\\}
esc=${esc//\"/\\\"}
if ! mac_osa "tell application \"System Events\" to keystroke \"$esc\""; then
  mac_gui_hint
  exit 1
fi
