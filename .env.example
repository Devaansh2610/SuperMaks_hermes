# ─── Voice: Fish Audio ────────────────────────────────────────────────
# Without a key the dashboard falls back to browser speech APIs.
# Get a key at https://fish.audio/go/api-keys/ and keep this file private.
#
# MODEL is the synthesis engine. VOICE_ID is the voice (a reference_id).
# They are different things and are sent in different places — do not swap them.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# ─── The Mac bridge ───────────────────────────────────────────────────
# MAC_SSH_HOST is an ssh target: a Host alias from ~/.ssh/config (recommended,
# run ./setup-mac.sh to create one) or plain user@hostname.
MAC_ENABLED=1
MAC_SSH_HOST=mac
MAC_TIMEOUT=20
MAC_SHOT_PX=1100
MAC_STATUS_TTL=4

# How cautious mac-sh / mac-osa are before touching the Mac. Enforced in
# tools/mac-guard.sh, not by the model's instructions — it blocks and waits
# for a click in the dashboard, it does not just ask nicely.
#   risky — confirm anything destructive (rm, sudo, mv, chmod -R…); default
#   all   — confirm every mac-sh / mac-osa call, no exceptions
#   off   — no confirmation gate (not recommended)
MAC_CONFIRM_MODE=risky
MAC_APPROVAL_TIMEOUT=90

# ─── Hermes ───────────────────────────────────────────────────────────
# The profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# ─── Dashboard ────────────────────────────────────────────────────────
SUPERMAKS_WORKDIR=~
SUPERMAKS_PERMISSION=normal
SUPERMAKS_TIMEOUT=120
SUPERMAKS_PORT=8730
SUPERMAKS_OPEN=1
