# ─── Voice: Fish Audio ────────────────────────────────────────────────
# Without a key the dashboard falls back to browser speech APIs.
# Get a key at https://fish.audio/go/api-keys/ and keep this file private.
#
# MODEL is the synthesis engine. VOICE_ID is the voice (a reference_id).
# They are different things and are sent in different places — do not swap them.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# ─── The wake-phrase jingle ───────────────────────────────────────────
# Plays when the dashboard hears "wake up daddy's home," from the top, capped
# at WAKE_SONG_SECONDS. No audio file is ever bundled with this project.
# It plays UNDERNEATH the greeting, not before it, and ducks further while
# SuperMaks is speaking.
#   open    — opens WAKE_SONG_URL in its own YouTube window (takes focus)
#   local   — streams a file YOU already own, from WAKE_SONG_LOCAL_PATH
#   off     — disabled
WAKE_SONG_SOURCE=open
WAKE_SONG_URL=https://www.youtube.com/watch?v=xMaE6toi4mk&list=RDxMaE6toi4mk&start_radio=1&pp=ygUcc2hvdWxkIEkgc3RheSBvciBzaG91bGQgaSBnb6AHAQ%3D%3D
WAKE_SONG_VOLUME=0.35
WAKE_SONG_DUCK=0.10
# WAKE_SONG_LOCAL_PATH=/home/you/Music/should-i-stay-or-should-i-go.mp3
WAKE_SONG_SECONDS=105

# The HUD goes dormant (wake-phrase-only) every time it's launched, and again
# after this many hours with no prompt — so it drops back to "asleep, waiting
# to be woken" on its own rather than staying lit all day.
# Opened all at once when it wakes, alongside the greeting, each its own new
# window (see WAKE_BROWSER_APP). Comma-separated; blank for none.
WAKE_TABS=https://github.com/,https://www.netflix.com/,https://medium.com/tag/ai-research

WAKE_IDLE_HOURS=4.5

# The .app macOS opens the wake links in, one separate new window per link.
WAKE_BROWSER_APP=Safari

# Each wake window's width/height as a fraction of the screen (0.45 = 45%).
WAKE_WINDOW_SCALE=0.45

# ─── Hermes ───────────────────────────────────────────────────────────
# The profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# ─── Dashboard ────────────────────────────────────────────────────────
SUPERMAKS_WORKDIR=~
SUPERMAKS_PERMISSION=normal
SUPERMAKS_TIMEOUT=120
SUPERMAKS_PORT=8730
SUPERMAKS_OPEN=1
